{
  "name": "nft-mint-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Headless NFT public-mint execution engine",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @mint-bot/cli dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fork": "vitest run --config vitest.fork.config.ts",
    "ops:health": "pnpm --filter @mint-bot/backend build && node scripts/ops-health.mjs",
    "lint": "eslint packages/",
    "typecheck": "tsc --noEmit -p packages/engine/tsconfig.json && tsc --noEmit -p packages/backend/tsconfig.json && tsc --noEmit -p packages/cli/tsconfig.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
