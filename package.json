{
  "name": "nft-mint-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Headless NFT public-mint execution engine",
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r --if-present run build",
    "dev": "pnpm --filter @mint-bot/cli dev",
    "test": "corepack pnpm exec vitest run",
    "test:watch": "vitest",
    "test:fork": "vitest run --config vitest.fork.config.ts",
    "ops:health": "node scripts/healthcheck.mjs",
    "ops:policy": "node scripts/validate-policy.mjs",
    "ops:secret-boundary": "node scripts/check-secret-boundary.mjs",
    "ops:redact-log": "node scripts/redact-log.mjs",
    "ops:backup": "node scripts/backup.mjs",
    "ops:restore-check": "node scripts/restore-check.mjs",
    "ops:negative-cases": "node scripts/negative-cases.mjs",
    "ops:fork-replay": "node scripts/fork-replay.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "corepack pnpm --filter @mint-bot/engine exec tsc --noEmit -p tsconfig.json && corepack pnpm --filter @mint-bot/backend exec tsc --noEmit -p tsconfig.json && corepack pnpm --filter @mint-bot/cli exec tsc --noEmit -p tsconfig.json && corepack pnpm --filter @mint-bot/database exec tsc --noEmit -p tsconfig.json",
    "ops:health:harness": "pnpm --filter @mint-bot/backend build && node scripts/ops-health.mjs",
    "ops:fork-replay:strict": "node scripts/ops-fork-replay.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
