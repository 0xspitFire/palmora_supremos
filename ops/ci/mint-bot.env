# CI-safe configuration: no host secrets, no wallet material, no live mode.
MINT_BOT_SERVICE_MODE=dry-run
MINT_BOT_STATE_PATH=/tmp/mint-bot-ci/mintbot.sqlite
MINT_BOT_JOBS_PATH=/tmp/mint-bot-ci/orchestrator-jobs.json
MINT_BOT_BACKUP_DIR=/tmp/mint-bot-ci/backups
MINT_BOT_BACKUP_STATUS_PATH=/tmp/mint-bot-ci/backups/status.json
MINT_BOT_RESTART_COUNTER_PATH=/tmp/mint-bot-ci/restarts
MINT_BOT_LOG_PATH=/tmp/mint-bot-ci/orchestrator.log
KILL_SWITCH_PATH=/tmp/mint-bot-ci/killswitch
MINT_BOT_REQUIRE_STARTUP_KILL_SWITCH=false
MINT_BOT_TELEGRAM_ENABLED=false
MINT_BOT_BIND_HOST=127.0.0.1
MINT_BOT_HEALTH_PORT=8780
MINT_BOT_SCHEDULER_INTERVAL_MS=1000
MINT_BOT_RECONCILIATION_INTERVAL_MS=30000
MINT_BOT_MAX_CONCURRENT_JOBS=1
MINT_BOT_LOG_MAX_BYTES=1048576
MINT_BOT_LOG_MAX_FILES=2
