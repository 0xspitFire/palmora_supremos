[Unit]
Description=MintBot encrypted SQLite backup
After=mint-bot.service

[Service]
Type=oneshot
User=mintbot
Group=mintbot
WorkingDirectory=/opt/mint-bot/current
EnvironmentFile=/etc/mint-bot/mint-bot.env
# The host secret manager must add BACKUP_ENCRYPTION_KEY to the process
# environment for this unit invocation only. It is not stored in this file.
ExecStart=/usr/bin/node /opt/mint-bot/current/scripts/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/mint-bot /var/log/mint-bot
UMask=0077
CapabilityBoundingSet=
