[Unit]
Description=MintBot encrypted SQLite backup
After=mint-bot.service

[Service]
Type=oneshot
User=mintbot-backup
Group=mintbot-status
WorkingDirectory=/opt/mint-bot/current
EnvironmentFile=/etc/mint-bot/mint-bot.env
# The host provisions these owner-only source files. systemd copies them into
# a private per-service credential directory; no secret belongs in mint-bot.env.
LoadCredential=backup-encryption-key:/etc/mint-bot/secrets/backup-encryption-key
LoadCredential=r2-access-key-id:/etc/mint-bot/secrets/r2-access-key-id
LoadCredential=r2-secret-access-key:/etc/mint-bot/secrets/r2-secret-access-key
ExecStart=/usr/bin/node /opt/mint-bot/current/scripts/backup-service.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/lib/mint-bot
ReadWritePaths=/var/lib/mint-bot/backups /var/lib/mint-bot/backup-status
# Status is 0640 for the read-only mintbot-status handoff. Snapshot and
# checksum files are explicitly created 0600 and remain backup-user-only.
UMask=0027
LimitCORE=0
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
