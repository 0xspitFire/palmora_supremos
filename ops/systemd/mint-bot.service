[Unit]
Description=MintBot supervised orchestrator (dry-run by default)
Wants=network-online.target
After=network-online.target
# Restart limit: five failed starts within five minutes stop the restarts. systemd only honours these two settings in the Unit section.
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
User=mintbot
Group=mintbot
SupplementaryGroups=mintbot-status
WorkingDirectory=/opt/mint-bot/current
EnvironmentFile=/etc/mint-bot/mint-bot.env
ExecStartPre=/usr/bin/test -f /var/lib/mint-bot/killswitch
ExecStart=/usr/bin/node /opt/mint-bot/current/packages/cli/dist/orchestrator-service.js
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/mint-bot /var/log/mint-bot
# The orchestrator may consume backup readiness but cannot replace or forge it,
# even though the wider state tree is writable for its own database and jobs.
ReadOnlyPaths=/var/lib/mint-bot/backup-status
UMask=0077
LimitCORE=0
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
