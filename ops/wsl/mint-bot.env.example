# Non-secret local WSL/service configuration. Do not add credentials here.
# Production secrets belong in a root-managed, service-readable but
# service-nonwritable directory outside /var/lib/mint-bot. The host secret
# manager may install files in /etc/mint-bot/secrets. The directory is owned by
# root, files read by MintBot are root:mintbot with mode 0440, and systemd
# mounts /etc read-only for the service. The engine accepts that production
# mode and local files owned by the invoking operator with mode 0600. This example only names those files;
# it does not provision them or make the custody gate complete.
MINT_BOT_SERVICE_MODE=dry-run
MINT_BOT_CUSTODY=turnkey
MINT_BOT_SECRET_ROOT=/etc/mint-bot/secrets
TURNKEY_SECRET_FILE=/etc/mint-bot/secrets/turnkey.env
MINT_BOT_STATE_PATH=/var/lib/mint-bot/mintbot.sqlite
MINT_BOT_JOBS_PATH=/var/lib/mint-bot/orchestrator-jobs.json
MINT_BOT_BACKUP_DIR=/var/lib/mint-bot/backups
MINT_BOT_BACKUP_STATUS_PATH=/var/lib/mint-bot/backups/status.json
MINT_BOT_RESTART_COUNTER_PATH=/var/lib/mint-bot/restarts
MINT_BOT_LOG_PATH=/var/log/mint-bot/orchestrator.log
KILL_SWITCH_PATH=/var/lib/mint-bot/killswitch
MINT_BOT_REQUIRE_STARTUP_KILL_SWITCH=true
MINT_BOT_TELEGRAM_ENABLED=true
SECRET_STORE_PATH=/etc/mint-bot/secrets/runtime.env
MINT_BOT_BIND_HOST=127.0.0.1
MINT_BOT_HEALTH_PORT=8780
MINT_BOT_SCHEDULER_INTERVAL_MS=1000
MINT_BOT_RECONCILIATION_INTERVAL_MS=30000
MINT_BOT_MAX_CONCURRENT_JOBS=1
MINT_BOT_LOG_MAX_BYTES=10485760
MINT_BOT_LOG_MAX_FILES=5
MINT_BOT_CANONICAL_URL=http://127.0.0.1:8780

# Backup scripts require BACKUP_ENCRYPTION_KEY to be injected for the backup
# process lifetime by the host secret manager. Never put that value here.
BACKUP_RETENTION_DAYS=30
BACKUP_STATUS_PATH=/var/lib/mint-bot/backups/status.json

# Reserved production evidence references. Provisioning these paths does not
# create the files. Each file is written only after its corresponding control
# or witnessed drill passes. `pnpm ops:evidence` reports reference presence;
# it deliberately does not grant human approval.
MINT_BOT_RECOVERY_EVIDENCE_PATH=/var/lib/mint-bot/evidence/recovery.json
MINT_BOT_ROTATION_REVOCATION_EVIDENCE_PATH=/var/lib/mint-bot/evidence/rotation-revocation.json
MINT_BOT_HEAP_CORE_POLICY_PATH=/etc/mint-bot/heap-core-policy.json
MINT_BOT_BACKUP_RESTORE_EVIDENCE_PATH=/var/lib/mint-bot/evidence/backup-restore.json
MINT_BOT_SERVICE_SUPERVISION_EVIDENCE_PATH=/var/lib/mint-bot/evidence/service-supervision.json
